{
  "name": "@wega-labs/fovea-client",
  "version": "0.1.0",
  "description": "Zero-runtime-dependency Node and Electron client for the Fovea gaze engine",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "generate": "node scripts/generate-types.mjs",
    "generate:check": "node scripts/generate-types.mjs --check",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepack": "npm run generate:check && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "accessibility",
    "electron",
    "eye-tracking",
    "gaze",
    "typescript"
  ],
  "author": "Wega Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wega-Labs/fovea.git",
    "directory": "packages/fovea-client"
  },
  "bugs": "https://github.com/Wega-Labs/fovea/issues",
  "homepage": "https://github.com/Wega-Labs/fovea#readme",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
