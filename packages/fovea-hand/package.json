{
  "name": "@wega-labs/fovea-hand",
  "version": "0.1.0",
  "description": "Local camera hand tracking, forgiving targeting, and input intents for host applications.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "examples/basic"
  ],
  "scripts": {
    "check:core": "node check-core.mjs",
    "build": "npm run check:core && tsc -p tsconfig.json && node build.mjs",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts && node --test test/*.test.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "accessibility",
    "hand-tracking",
    "gesture",
    "mediapipe",
    "typescript"
  ],
  "author": "Wega Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wega-Labs/fovea.git",
    "directory": "packages/fovea-hand"
  },
  "bugs": "https://github.com/Wega-Labs/fovea/issues",
  "homepage": "https://github.com/Wega-Labs/fovea#readme",
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "1eurofilter": "1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.3",
    "eslint": "^9.39.4",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.6"
  }
}
